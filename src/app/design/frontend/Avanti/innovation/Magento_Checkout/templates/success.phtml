<?php /** @var $block \Magento\Checkout\Block\Onepage\Success */ ?>

<div class="checkout-success">
    <div class="checkout-success-top-message">
        <!-- verifica se existe um pedido válido -->
        <?php if ($block->getOrderId()) : ?>
            <!-- container de botão de impressão -->
            <div class="actions-toolbar print-actions">
                <div class="primary">
                    <!-- link para imprimir o recibo do pedido -->
                    <a class="action print"
                        href="<?= $block->escapeUrl($block->getPrintUrl()) ?>"
                        target="_blank"
                        rel="noopener">
                        <span><?= $block->escapeHtml(__('Print Receipt')) ?></span>
                    </a>
                </div>
            </div>
        <?php endif; ?>

        <!-- mensagem principal de agradecimento -->
        <h2><?= $block->escapeHtml(__('Thank you for your purchase!')) ?></h2>
    </div>

    <?php if ($block->getOrderId()) : ?>
        <?php if ($block->getCanViewOrder()) : ?>
            <p class="order"><?= $block->escapeHtml(__('Your order number is: %1.', sprintf('<a href="%s" class="order-number"><strong>%s</strong></a>', $block->escapeUrl($block->getViewOrderUrl()), $block->getOrderId())), ['a', 'strong']) ?></p>
        <?php else : ?>
            <p class="order"><?= $block->escapeHtml(__('Your order # is: <span>%1</span>.', $block->getOrderId()), ['span']) ?></p>
        <?php endif; ?>
        <p class="additional-text"><?= $block->escapeHtml(__('We\'ll email you an order confirmation with details and tracking info.')) ?></p>
    <?php endif; ?>

    <?= $block->getAdditionalInfoHtml() ?>

    <div class="actions-toolbar">
        <div class="primary">
            <a class="action primary continue" href="<?= $block->escapeUrl($block->getContinueUrl()) ?>"><span><?= $block->escapeHtml(__('Continue Shopping')) ?></span></a>
        </div>
    </div>
</div>