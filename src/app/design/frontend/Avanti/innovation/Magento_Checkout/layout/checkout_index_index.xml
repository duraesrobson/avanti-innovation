<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="checkout.header.wrapper">
            <!-- cria o bloco custom de etapas no header para o desktop -->
            <block class="Magento\Framework\View\Element\Template" name="checkout.steps.desktop" template="Magento_Checkout::custom_steps.phtml">
                <arguments>
                    <argument name="css_class" xsi:type="string">desktop</argument>
                </arguments>
            </block>

            <!-- adiciona a flag no header -->
            <block class="Magento\Framework\View\Element\Template" name="checkout.compra.segura" template="Magento_Checkout::flag_compra_segura.phtml"/>
        </referenceContainer>

        <!-- move o custom steps após a logo dentro do header, quando desktop -->
        <move element="checkout.steps.desktop" destination="checkout.header.wrapper" after="logo" />

        <!-- move a flag após os steps -->
        <move element="checkout.compra.segura" destination="checkout.header.wrapper" after="checkout.steps.desktop" />

        <referenceContainer name="content">
            <!-- cria o bloco custom de etapas no corpo, para mobile -->
            <block class="Magento\Framework\View\Element\Template" name="checkout.steps.mobile" template="Magento_Checkout::custom_steps.phtml" before="checkout.root">
                <arguments>
                    <argument name="css_class" xsi:type="string">mobile</argument>
                </arguments>
            </block>
        </referenceContainer>

        <!-- remove o container da newsletter criado no default -->
        <referenceContainer name="footer.newsletter" remove="true"/>

        <referenceContainer name="before.body.end">
            <!-- wrapper do footer do checkout -->
            <container name="checkout.footer.wrapper" htmlTag="div" htmlClass="checkout-footer-wrapper" before="-">

                <!-- coluna esquerda: CMS Block -->
                <block class="Magento\Cms\Block\Block" name="checkout.footer.text">
                    <arguments>
                        <argument name="block_id" xsi:type="string">footer_checkout</argument>
                    </arguments>
                </block>

                <!-- coluna direita: logos de pagamento -->
                <block class="Magento\Framework\View\Element\Template" name="checkout.footer.flags" template="Magento_Theme::html/flags-cards.phtml"/>
            </container>
        </referenceContainer>
    </body>
</page>
