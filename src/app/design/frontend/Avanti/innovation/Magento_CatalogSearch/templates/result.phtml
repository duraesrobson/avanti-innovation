<?php
//  ARQUIVO RESPONSÁVEL PELA EXIBIÇÃO DOS RESULTADOS DE BUSCA

// @codingStandardsIgnoreFile

use Magento\CatalogSearch\Block\Result;

/** @var \Magento\Search\Helper\Data $searchHelper */
$searchHelper = $this->helper(\Magento\Search\Helper\Data::class);

// bloco principal que controla a página de resultados de busca
/** @var $block Result */

// HTML da listagem de produtos retornados pela busca
$productList = $block->getProductListHtml();
?>

<?php if ($block->getResultCount()) : ?>
    <!-- link RSS de produtos buscados (quando habilitado) -->
    <?= /* @noEscape */ $block->getChildHtml('tagged_product_list_rss_link') ?>

    <!-- container principal dos resultados de busca -->
    <div class="search results search-results-custom">

        <!-- título da página com o termo pesquisado -->
        <h1 class="search-title">
            <?= __('Resultado de busca por') ?>
            <span class="search-term">
                "<?= $searchHelper->getEscapedQueryText() ?>"
            </span>
        </h1>

        <!-- mensagens informativas do Magento (avisos, sugestões, etc) -->
        <?php if ($messages = $block->getNoteMessages()) : ?>
            <div class="message notice">
                <div>
                    <?php foreach ($messages as $message) : ?>
                        <?= /* @noEscape */ $message ?><br />
                    <?php endforeach; ?>
                </div>
            </div>
        <?php endif; ?>

        <!-- renderização da listagem de produtos -->
        <?= /* @noEscape */ $productList ?>

    </div>

<?php else : ?>
    <!-- estado vazio: nenhum resultado encontrado -->
    <div class="message-notice">

        <div class="message-notice-top">
            <h1 class="search-title">
                <?= __('Não encontramos resultados para') ?>
                <span class="search-term">
                    "<?= $searchHelper->getEscapedQueryText() ?>"
                </span>
            </h1>
        </div>

        <!-- sugestões para melhorar a busca -->
        <div class="message-notice-bottom">
            <h1 class="what-text">
                <?= __('O que devo fazer?') ?>
            </h1>

            <ul class="what-list">
                <li> <?= __('Verifique os termos digitados') ?> </li>
                <li> <?= __('Utilize sinônimos ao termo desejado') ?> </li>
                <li> <?= __('Tente utilizar uma única palavra') ?> </li>
                <li> <?= __('Utilize os termos genéricos na busca') ?> </li>
            </ul>
        </div>
    </div>

    <!-- exibe um bloco CMS (prateleira de ofertas criada no PageBuilder) quando não há resultados -->
    <?php echo $this->getLayout()->createBlock('Magento\Cms\Block\Block')->setBlockId('slider-prateleira-ofertas')->toHtml(); ?>

<?php endif; ?>