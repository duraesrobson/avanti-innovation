<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <!-- ESTRUTURA DA PÁGINA DE CATEGORIA -->

    <body>

        <!-- coloca a seção do banner logo em cima -->
        <referenceContainer name="columns.top">
            <block class="Magento\Catalog\Block\Category\View" name="plp_banner" template="Magento_Theme::html/plp-banner.phtml"/>
        </referenceContainer>

        <!-- referencia do sidebar -->
        <referenceContainer name="sidebar.main">
            <!-- sidebar principal -->
            <block class="Magento\Framework\View\Element\Template" name="sidebar.main.custom" before="-"/>
        </referenceContainer>

        <!-- move o sidebar additional de wishlist logo abaixo dos filtros -->
        <move element="sidebar.additional" destination="sidebar.main" after="sidebar.main.custom"/>


        <!-- coloca o texto seo da categoria antes do newsletter -->
        <referenceContainer name="main.content">
            <block class="Magento\Catalog\Block\Category\View" name="category.seo.footer" template="Magento_Catalog::product/list/seo-text.phtml" before="footer.newsletter"/>
        </referenceContainer>

    </body>
</page>